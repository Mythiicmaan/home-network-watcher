{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "netwatch-sample",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:NETWATCH_DATA_DIR = (Join-Path $PWD 'data/sample'); ./.venv/Scripts/python.exe -m netwatch --sample --port 8768"
      ],
      "port": 8768
    },
    {
      "name": "readme-screens",
      "runtimeExecutable": "./.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "http.server", "8769", "--bind", "127.0.0.1", "--directory", "docs/screens"],
      "port": 8769
    }
  ]
}
